{% extends "base.jinja" %}
{% block title %}Add a new product{% endblock %}

{% block content %}
<h2>Add a new product</h2>

<form method="POST" action="{{ url_for('add_product') }}" class="product-form" enctype="multipart/form-data">

    <label for="name">Product name:</label>
    <input type="text" id="name" name="name" required>

    <label for="price">Price ($):</label>
    <input type="number" id="price" name="price" step="0.01" min="0.01" required>

    <label for="details">Details / description:</label>
    <textarea id="details" name="details" rows="5" required></textarea>

    <label for="image">Product image:</label>
    <input type="file" id="image" name="image_file" accept=".jpg, .jpeg, .png, .gif" required>

    <button type="submit" class="submit-button">Save and add product</button>
</form>
{% endblock %}
