{% extends "base.jinja" %}

{% block title %}
Product list
{% endblock %}

{% block content %}

<h2>Product list</h2>

{% if products %}
<div class="product-grid">
    {% for product in products %}
    <div class="product-card">

        <img
                src="{{ url_for('static', filename=product.image_filename) }}"
                alt="Photo of {{ product.name }}"
                class="product-image"
        >

        <h3>{{ product.name }}</h3>

        <p class="product-price">
            {{ product.price }} $
        </p>

        <a
                href="{{ url_for('product_detail', product_id=product.id) }}"
                class="details-button"
        >
            View details
        </a>

        <form
                action="{{ url_for('delete_product', product_id=product.id) }}"
                method="post"
        >
            <button type="submit" class="delete-button">
                Delete product
            </button>
        </form>

    </div>
    {% endfor %}
</div>

{% else %}
<p class="no-products">
    No products yet.
</p>
{% endif %}

{% endblock %}
